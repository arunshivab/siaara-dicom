<?xml version="1.0" encoding="utf-8"?>
<!-- SIAARA Viewer: zero downloads (owner decision b). The only package source is the vendored folder
     app/vendor/packs, which holds exactly the SDK pack the build needs (Blazor's script pack
     Microsoft.AspNetCore.App.Internal.Assets, version pinned in Directory.Build.targets). The default
     nuget.org source and any machine-wide sources are cleared, so a restore can never reach the network. -->
<configuration>
  <packageSources>
    <clear />
    <add key="siaara-vendor" value="vendor/packs" />
  </packageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
  <auditSources>
    <clear />
  </auditSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
