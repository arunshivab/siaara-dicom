<Project>
  <!-- Shared settings for every project of the SIAARA Viewer app (code owned by Sthraas Intelligence
       Pvt Ltd). Zero third-party dependencies: only the .NET SDK and the ASP.NET Core shared framework.
       The analyzers are the ones that ship with the SDK. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.1.0</Version>
    <Authors>Arun Shiva B</Authors>
    <Company>Sthraas Intelligence Pvt Ltd</Company>
    <Product>SIAARA Viewer</Product>
    <Copyright>Copyright (c) Sthraas Intelligence Pvt Ltd. All rights reserved.</Copyright>
    <IsPackable>false</IsPackable>
    <SiaaraAppRoot>$(MSBuildThisFileDirectory)</SiaaraAppRoot>
    <SiaaraBindingsSrc>$(MSBuildThisFileDirectory)../bindings/csharp/src/</SiaaraBindingsSrc>
    <!-- Zero downloads (owner decision b): restore only from the vendored folder (see NuGet.config),
         whichever directory the build is started from, and never audit against an online feed. -->
    <RestoreConfigFile>$(MSBuildThisFileDirectory)NuGet.config</RestoreConfigFile>
    <RestoreSources>$(MSBuildThisFileDirectory)vendor/packs</RestoreSources>
    <RestoreAdditionalProjectSources></RestoreAdditionalProjectSources>
    <RestoreFallbackFolders>clear</RestoreFallbackFolders>
    <NuGetAudit>false</NuGetAudit>
    <!-- The one SDK pack the app needs, kept in vendor/packs. Bump together with the .nupkg file. -->
    <SiaaraAspNetAssetsPackVersion>10.0.14</SiaaraAspNetAssetsPackVersion>
  </PropertyGroup>
</Project>
