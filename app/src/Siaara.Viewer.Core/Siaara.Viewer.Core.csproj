<Project Sdk="Microsoft.NET.Sdk">
  <!-- Viewer logic without UI: toolkit facade and scheduler, store, import, imaging, viewing,
       measurements, overlay text, settings, audit. Only Toolkit/Tk.cs touches the bindings' names. -->
  <PropertyGroup>
    <AssemblyName>Siaara.Viewer.Core</AssemblyName>
    <RootNamespace>Siaara.Viewer.Core</RootNamespace>
    <!-- LibraryImport (source-generated P/Invoke) for the OS key stores and the peer-user check. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(SiaaraBindingsSrc)Siaara/Siaara.csproj" />
    <ProjectReference Include="$(SiaaraBindingsSrc)Siaara.Interop/Siaara.Interop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Siaara.Viewer.Tests" />
  </ItemGroup>
</Project>
