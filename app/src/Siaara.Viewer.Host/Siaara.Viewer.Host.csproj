<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Desktop host: ABI check, single instance, store open, Kestrel on 127.0.0.1:0, launch secret,
       opening the window (decision A1 option a, isolated in BrowserLauncher), shutdown. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>siaara-viewer</AssemblyName>
    <RootNamespace>Siaara.Viewer.Host</RootNamespace>
    <!-- Blazor's own script (_framework/blazor.web.js) ships in .NET 10 as the SDK pack
         Microsoft.AspNetCore.App.Internal.Assets, which the Web SDK fetches only when the app project
         itself holds .razor files (ours are in Siaara.Viewer.Web). This asks for it explicitly. It is a
         framework pack of the SDK (like the NativeAOT compiler pack), not a PackageReference. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Siaara.Viewer.Web/Siaara.Viewer.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Siaara.Viewer.Tests" />
  </ItemGroup>
</Project>
