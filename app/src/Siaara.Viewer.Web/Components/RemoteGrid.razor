@* SIAARA Viewer. Copyright (c) Sthraas Intelligence Pvt Ltd. Studies found on a node; values are shown as received (formatted for display only). *@
@inject ViewerRuntime Rt
<div class="grid-wrap remote">
    <table class="grid">
        <thead>
            <tr><th></th><th>Patient name</th><th>ID</th><th>Sex/Age</th><th>Study date</th><th>Modality</th><th>Description</th><th>Accession</th><th class="num">Images</th><th>Local</th><th></th></tr>
        </thead>
        <tbody>
            @if (Hint is not null)
            {
                <tr><td colspan="11" class="muted">@Hint</td></tr>
            }
            else if (Rows is null)
            {
                <tr><td colspan="11" class="muted">Searching...</td></tr>
            }
            else if (Rows.Count == 0)
            {
                <tr><td colspan="11" class="muted">No studies match on this node.</td></tr>
            }
            else
            {
                @foreach (var r in Rows)
                {
                    StudyRow s = r.Study;
                    bool open = _open.Contains(s.StudyInstanceUid);
                    <tr class="@(Selected?.Study.StudyInstanceUid == s.StudyInstanceUid ? "sel" : "")" @key="s.StudyInstanceUid" @onclick="() => OnSelect.InvokeAsync(r)">
                        <td><button class="link expand" title="Series" @onclick="() => Toggle(r)" @onclick:stopPropagation="true">@(open ? "▾" : "▸")</button></td>
                        <td>@s.DisplayName</td>
                        <td>@s.PatientId</td>
                        <td>@s.DisplaySexAge</td>
                        <td>@s.DisplayDate</td>
                        <td>@s.DisplayModalities</td>
                        <td>@s.Description</td>
                        <td>@s.AccessionNumber</td>
                        <td class="num">@(r.RemoteImages >= 0 ? r.RemoteImages.ToString(CultureInfo.InvariantCulture) : "?")</td>
                        <td><span class="local @LocalClass(r.Local)" title="@LocalTitle(r.LocalImages, r.RemoteImages)">@LocalText(r.Local)</span></td>
                        <td class="row-actions">
                            <button class="btn retrieve" @onclick="() => OnRetrieve.InvokeAsync((r, null))" @onclick:stopPropagation="true">Retrieve</button>
                            <button class="btn open-remote" disabled="@(r.Local == LocalPresence.None)" @onclick="() => OnOpen.InvokeAsync(r)" @onclick:stopPropagation="true"
                                    title="Opens what has arrived; images still on their way are added as they come.">Open</button>
                        </td>
                    </tr>
                    @if (open)
                    {
                        @if (_errors.TryGetValue(s.StudyInstanceUid, out string? err))
                        {
                            <tr class="sub"><td></td><td colspan="10" class="err">@err</td></tr>
                        }
                        else if (!_series.TryGetValue(s.StudyInstanceUid, out var list))
                        {
                            <tr class="sub"><td></td><td colspan="10" class="muted">Listing series...</td></tr>
                        }
                        else
                        {
                            @foreach (var se in list)
                            {
                                <tr class="sub" @key="se.SeriesInstanceUid">
                                    <td></td>
                                    <td colspan="5">Series @(se.SeriesNumber?.ToString(CultureInfo.InvariantCulture) ?? "-") @se.Modality</td>
                                    <td colspan="2">@se.Description</td>
                                    <td class="num">@(se.RemoteImages >= 0 ? se.RemoteImages.ToString(CultureInfo.InvariantCulture) : "?")</td>
                                    <td><span class="local @LocalClass(se.Local)" title="@LocalTitle(se.LocalImages, se.RemoteImages)">@LocalText(se.Local)</span></td>
                                    <td class="row-actions"><button class="btn" @onclick="() => OnRetrieve.InvokeAsync((r, se))">Retrieve</button></td>
                                </tr>
                            }
                            @if (list.Count == 0)
                            {
                                <tr class="sub"><td></td><td colspan="10" class="muted">The node lists no series for this study.</td></tr>
                            }
                        }
                    }
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public string NodeId { get; set; } = "";
    [Parameter] public IReadOnlyList<RemoteStudyRow>? Rows { get; set; }
    [Parameter] public RemoteStudyRow? Selected { get; set; }
    [Parameter] public string? Hint { get; set; }
    /// <summary>Changes when local images arrived: open series lists are fetched again for their Local column.</summary>
    [Parameter] public int LocalVersion { get; set; }
    [Parameter] public EventCallback<RemoteStudyRow> OnSelect { get; set; }
    [Parameter] public EventCallback<RemoteStudyRow> OnOpen { get; set; }
    [Parameter] public EventCallback<(RemoteStudyRow Study, RemoteSeriesRow? Series)> OnRetrieve { get; set; }

    private readonly HashSet<string> _open = new(StringComparer.Ordinal);
    private readonly Dictionary<string, IReadOnlyList<RemoteSeriesRow>> _series = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _errors = new(StringComparer.Ordinal);
    private IReadOnlyList<RemoteStudyRow>? _rowsSeen;
    private int _versionSeen;

    protected override async Task OnParametersSetAsync()
    {
        if (!ReferenceEquals(_rowsSeen, Rows))
        {
            // A new search: nothing is expanded.
            _rowsSeen = Rows;
            _open.Clear();
            _series.Clear();
            _errors.Clear();
        }
        else if (_versionSeen != LocalVersion)
        {
            _versionSeen = LocalVersion;
            foreach (string uid in _open.ToArray())
            {
                await Load(uid).ConfigureAwait(true);
            }
        }
        _versionSeen = LocalVersion;
    }

    private async Task Toggle(RemoteStudyRow r)
    {
        string uid = r.Study.StudyInstanceUid;
        if (!_open.Add(uid))
        {
            _open.Remove(uid);
            return;
        }
        await Load(uid).ConfigureAwait(true);
    }

    private async Task Load(string uid)
    {
        try
        {
            _errors.Remove(uid);
            _series[uid] = await Rt.Network.Search.SearchSeriesAsync(NodeId, uid, CancellationToken.None).ConfigureAwait(true);
        }
        catch (NetworkException e)
        {
            _errors[uid] = e.Message;
        }
        catch (Siaara.Viewer.Core.Toolkit.TkException e)
        {
            _errors[uid] = "The local store could not be read: " + e.Message + ".";
        }
    }

    private static string LocalText(LocalPresence p) => p switch { LocalPresence.Complete => "complete", LocalPresence.Partial => "partial", _ => "none" };
    private static string LocalClass(LocalPresence p) => p switch { LocalPresence.Complete => "complete", LocalPresence.Partial => "partial", _ => "none" };
    private static string LocalTitle(int local, int remote) => local.ToString(CultureInfo.InvariantCulture) + " images in the local store"
        + (remote >= 0 ? ", " + remote.ToString(CultureInfo.InvariantCulture) + " on the node" : "; the node did not say how many it has");
}
