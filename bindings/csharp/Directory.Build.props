<Project>
  <!-- Shared settings for every C# project of the SIAARA bindings. No NuGet packages anywhere:
       the analyzers used are the ones that ship with the .NET SDK. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Authors>Sthraas Intelligence Pvt Ltd</Authors>
    <Company>Sthraas Intelligence Pvt Ltd</Company>
    <Copyright>Copyright (c) 2026 Sthraas Intelligence Pvt Ltd. All rights reserved.</Copyright>
    <Product>SIAARA DICOM Toolkit</Product>
  </PropertyGroup>

  <!-- Version: read from the project(siaara VERSION x.y.z) line of the top-level CMakeLists.txt,
       the single source of the toolkit version (docs/RELEASING.md). Never set a version here.
       A release candidate build passes -p:VersionSuffix=rc.N: the package is then x.y.z-rc.N, the
       assembly and file versions stay x.y.z. -->
  <PropertyGroup>
    <SiaaraCMakeListsText>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../CMakeLists.txt'))</SiaaraCMakeListsText>
    <VersionPrefix>$([System.Text.RegularExpressions.Regex]::Match($(SiaaraCMakeListsText), 'project\(siaara VERSION ([0-9]+\.[0-9]+\.[0-9]+)').Groups.get_Item(1).Value)</VersionPrefix>
    <SiaaraCMakeListsText></SiaaraCMakeListsText>
  </PropertyGroup>

  <!-- Release / CI builds (-p:ContinuousIntegrationBuild=true): no build-machine paths in the
       assemblies or their embedded symbols. -->
  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))=/_/</PathMap>
  </PropertyGroup>

</Project>
