<Project Sdk="Microsoft.NET.Sdk">
  <!-- Public, idiomatic C# API over the SIAARA C API. No unsafe code: all pointer work is in
       Siaara.Interop, which is packed into this package (it is not a separate package). -->
  <PropertyGroup>
    <AssemblyName>Siaara</AssemblyName>
    <RootNamespace>Siaara</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <PackageId>Siaara</PackageId>
    <Title>SIAARA DICOM Toolkit</Title>
    <Description>SIAARA DICOM Toolkit for .NET: Part 10 files, pixel data and codecs, character sets, DIMSE services (SCU and SCP), DICOMweb, local store, de-identification. Managed bindings over the native library, which is in this package under runtimes/&lt;rid&gt;/native. No package dependencies.</Description>
    <PackageTags>dicom;medical-imaging;pacs;dicomweb</PackageTags>
    <!-- The feed of the package is GitHub Packages (.github/workflows/publish-package.yml): the
         repository URL in the package is what ties it to this repository and its access rights. -->
    <RepositoryUrl>https://github.com/arunshivab/siaara-dicom</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../artifacts/packages</PackageOutputPath>
    <!-- Proprietary: the licence is the LICENSE file of the repository, shipped in the package.
         There is no SPDX expression for it, so PackageLicenseExpression is not used. -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Symbols are embedded in the assemblies (portable PDB inside Siaara.dll and
         Siaara.Interop.dll): no .snupkg and no symbol server are needed. -->
    <DebugType>embedded</DebugType>
    <IncludeSymbols>false</IncludeSymbols>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);SiaaraPackInterop</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Siaara.Interop/Siaara.Interop.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Siaara.Interop.dll goes into lib/net10.0 of this package. -->
  <Target Name="SiaaraPackInterop" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
                            Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' and '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>
  </Target>

  <!-- Native libraries: runtimes/<rid>/native/ for every supported RID. The build host's library
       comes from the CMake build (SiaaraNativeLibrary); CI provides the rest through
       SiaaraNativeArtifactsDir/<rid>/<file>. linux-x86 is not a .NET runtime identifier. -->
  <ItemGroup>
    <SiaaraPackRid Include="linux-x64;linux-arm64;win-x64;win-x86;win-arm64;osx-x64;osx-arm64" />
  </ItemGroup>
  <ItemGroup Condition="'$(SiaaraNativeLibrary)' != '' and '$(SiaaraNativeArtifactsDir)' == ''">
    <None Include="$(SiaaraNativeLibrary)" Pack="true" PackagePath="runtimes/$(SiaaraNativeRid)/native/$(SiaaraNativeFileName)"
          CopyToOutputDirectory="Never" Visible="false" />
  </ItemGroup>
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);SiaaraPackNativeArtifacts</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="SiaaraPackNativeArtifacts" Condition="'$(SiaaraNativeArtifactsDir)' != ''">
    <ItemGroup>
      <_SiaaraNativeArtifact Include="$(SiaaraNativeArtifactsDir)/%(SiaaraPackRid.Identity)/*siaara.dll;$(SiaaraNativeArtifactsDir)/%(SiaaraPackRid.Identity)/*siaara.so;$(SiaaraNativeArtifactsDir)/%(SiaaraPackRid.Identity)/*siaara.dylib">
        <Rid>%(SiaaraPackRid.Identity)</Rid>
      </_SiaaraNativeArtifact>
      <TfmSpecificPackageFile Include="@(_SiaaraNativeArtifact)" PackagePath="runtimes/%(_SiaaraNativeArtifact.Rid)/native/%(_SiaaraNativeArtifact.Filename)%(_SiaaraNativeArtifact.Extension)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Include="../../PACKAGE_README.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Include="$(SiaaraRepoRoot)LICENSE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
