# Keep generated tables byte-identical on every platform (their hashes are checked in tests).
* text=auto eol=lf
*.dcm binary
*.jpg binary
*.j2k binary
*.jls binary
# Fuzz seeds and regression inputs are raw bytes: never convert line endings.
fuzz/corpus/** binary
tests/regress/** binary
# Private-tag source data (data/private-tags): tab-separated text, LF on every platform.
*.tsv text eol=lf
