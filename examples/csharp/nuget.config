<?xml version="1.0" encoding="utf-8"?>
<!-- Local folder feed only: put Siaara.<version>.nupkg in ./packages (or change the path).
     No other package source is needed: the Siaara package has no dependencies. -->
<configuration>
  <packageSources>
    <clear />
    <add key="siaara-local" value="./packages" />
  </packageSources>
</configuration>
