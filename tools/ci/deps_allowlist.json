{
  "_comment": "Runtime dependencies allowed in shipped binaries (tools/ci/check_binaries.py deps). Patterns are fnmatch globs; Windows matching is case-insensitive. OS libraries and the platform C/C++ runtime only. On Linux the system OpenSSL is loaded with dlopen when TLS is first used and must never be linked. deny_release: libraries that release builds (SIAARA_STATIC_RUNTIME=ON) must not need; macOS keeps the system libc++ (part of the OS).",
  "linux": {
    "allow": [
      "libc.so.6",
      "libm.so.6",
      "libstdc++.so.6",
      "libgcc_s.so.1",
      "libpthread.so.0",
      "libdl.so.2",
      "ld-linux-x86-64.so.2",
      "ld-linux-aarch64.so.1",
      "ld-linux.so.2",
      "linux-vdso.so.1",
      "libsiaara.so*"
    ],
    "deny": [
      "libssl*",
      "libcrypto*"
    ],
    "deny_release": [
      "libstdc++*",
      "libgcc_s*"
    ]
  },
  "macos": {
    "allow": [
      "/usr/lib/libSystem.B.dylib",
      "/usr/lib/libc++.1.dylib",
      "/System/Library/Frameworks/Network.framework/*",
      "/System/Library/Frameworks/Security.framework/*",
      "/System/Library/Frameworks/CoreFoundation.framework/*",
      "@rpath/libsiaara*.dylib"
    ],
    "deny": [
      "*libssl*",
      "*libcrypto*"
    ],
    "deny_release": []
  },
  "windows": {
    "allow": [
      "kernel32.dll",
      "ws2_32.dll",
      "secur32.dll",
      "crypt32.dll",
      "advapi32.dll",
      "ncrypt.dll",
      "msvcp140.dll",
      "msvcp140_1.dll",
      "msvcp140_2.dll",
      "vcruntime140.dll",
      "vcruntime140_1.dll",
      "api-ms-win-crt-*.dll",
      "siaara.dll"
    ],
    "deny": [
      "libssl*",
      "libcrypto*"
    ],
    "deny_release": [
      "msvcp140*.dll",
      "vcruntime140*.dll",
      "api-ms-win-crt-*.dll",
      "ucrtbase.dll"
    ]
  }
}
